[Unit]
Description=gem-voice — Discord voice subprocess
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/gem-voice
ExecStart=%h/repos/gem-voice/venv/bin/python -m gem_voice
EnvironmentFile=%h/repos/gem-voice/.env
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5s

# Resource limits — keep this from drowning the host
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=default.target
