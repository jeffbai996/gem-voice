# Daemon
LOG_LEVEL=INFO
IPC_SOCKET_PATH=                                  # default: $XDG_RUNTIME_DIR/gem-voice.sock

# Discord voice — only this user's audio reaches the model
DISCORD_OWNER_USER_ID=

# Gemini Live
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
GEMINI_LANGUAGE=en-US

# Optional memory store integration (read-only HTTP)
# If unset, gem-voice starts sessions with no external context.
MEMORY_STORE_URL=
MEMORY_STORE_TIMEOUT_S=2.0
